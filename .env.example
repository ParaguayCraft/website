# Public values baked into the Next.js client bundle at build time.
# Do not expose secrets through NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SERVER_HOST=play.paraguaycraft.com
NEXT_PUBLIC_SERVER_DISPLAY_ADDRESS=play.paraguaycraft.com
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/paraguaycraft

# BlueMap must use a public HTTPS URL in production.
# Leave optional social URLs empty to omit those links from the site.
NEXT_PUBLIC_BLUEMAP_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Server-only value; it is not exposed to the browser.
SERVER_QUERY_PORT=25577
